## Pixabay API key — used server-side only (app/api/pixabay/*).
## Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

## Freesound API key — used server-side only (app/api/freesound/*).
## Get a free key at https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

## OpenAI API key — used server-side only (app/api/ai/*).
## Powers the Agentic AI panel in the production playground.
## Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

## Optional: override the model used for topic generation (default: gpt-4o-mini).
# OPENAI_MODEL=
