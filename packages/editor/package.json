{
  "name": "@elah/editor",
  "version": "0.3.2",
  "description": "Full React video editor SDK — timeline UI, WebGL2 preview, media library, drag and drop, and MP4 export",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tailwindcss -c ./tailwind.config.ts -i ./src/styles/index.css -o ./dist/styles.css --minify"
  },
  "keywords": [
    "video-editor",
    "react",
    "sdk",
    "timeline",
    "webgl",
    "webgl2",
    "gpu",
    "mp4",
    "export",
    "media-editor",
    "browser-video-editor",
    "video-sdk",
    "asset-panel",
    "preview",
    "typescript"
  ],
  "homepage": "https://www.elah.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/elahlabs/elah.git"
  },
  "bugs": {
    "url": "https://github.com/elahlabs/elah/issues"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@elah/core": "^0.3.0",
    "@elah/timeline": "^0.3.0",
    "immer": "^10.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
