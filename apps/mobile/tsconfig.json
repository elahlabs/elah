{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    // The @elah packages are typechecked against their BUILT declarations
    // (run `npm run build:packages` at the repo root first). Metro bundles them
    // from src; TypeScript reading src would pull core's DOM-typed renderer
    // into a React Native program.
    //
    // react, react-native and the Reanimated / gesture-handler peers are pinned
    // to THIS app's copies: the packages' declarations would otherwise resolve
    // the repo root's React 18 types.
    "paths": {
      "@elah/core": ["../../packages/core/dist/index.d.ts"],
      "@elah/core/engine": ["../../packages/core/dist/engine.d.ts"],
      "@elah/react": ["../../packages/react/dist/index.d.ts"],
      "@elah/react-native": ["../../packages/react-native/dist/index.d.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native-gesture-handler": ["./node_modules/react-native-gesture-handler"],
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-worklets": ["./node_modules/react-native-worklets"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"],
      "immer": ["./node_modules/immer"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
